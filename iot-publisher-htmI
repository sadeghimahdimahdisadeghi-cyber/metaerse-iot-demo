<!doctype html>
<html lang="fa">
<head>
<meta charset="utf-8">
<title>IoT Publisher — شبیه‌ساز سنسور</title>
<script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
<style>
  body{font-family: Tahoma,"B Nazanin",sans-serif;background:#f3fff6;padding:18px}
  .card{background:white;padding:14px;border-radius:8px;max-width:520px;margin:auto;box-shadow:0 6px 20px rgba(0,0,0,0.06)}
  h2{margin-top:0;color:#0b7a3b}
  .row{display:flex;align-items:center;gap:8px}
  input[type=range]{width:100%}
  button{background:#ed7d31;color:#fff;border:0;padding:8px 12px;border-radius:6px;cursor:pointer}
  .out{background:#f7f7f7;padding:8px;border-radius:6px;margin-top:8px;font-family:monospace}
</style>
</head>
<body>
<div class="card">
  <h2>شبیه‌ساز سنسور (پابلیشر MQTT)</h2>
  <p class="small">این صفحه رفتار سنسور را شبیه‌سازی می‌کند — مقدار شعاع را منتشر می‌کند (topic = <code>uni/geometry/radius</code>).</p>

  <label>شعاع (radius): <span id="val">1.00</span></label>
  <div class="row">
    <input id="slider" type="range" min="0.1" max="10" step="0.01" value="1.00"/>
  </div>

  <div style="margin-top:10px" class="row">
    <button id="publish">ارسال دستی</button>
    <button id="auto">Start Auto</button>
    <button id="stop" disabled>Stop</button>
    <div style="margin-left:auto" class="small">Topic: <code>uni/geometry/radius</code></div>
  </div>

  <div class="out" id="log">وضعیت: آماده</div>
</div>

<script>
const slider = document.getElementById('slider');
const val = document.getElementById('val');
const log = document.getElementById('log');
const btnPub = document.getElementById('publish');
const btnAuto = document.getElementById('auto');
const btnStop = document.getElementById('stop');

val.textContent = parseFloat(slider.value).toFixed(2);

slider.addEventListener('input', () => {
  val.textContent = parseFloat(slider.value).toFixed(2);
});

// MQTT - HiveMQ WebSocket
const host = 'wss://broker.hivemq.com:8000/mqtt';
const topic = 'uni/geometry/radius';
let client = null;

function connectMQTT(cb){
  if(client && client.connected) { cb(); return; }
  client = mqtt.connect(host);
  client.on('connect', () => {
    log.textContent = 'MQTT متصل شد';
    cb();
  });
  client.on('error', (e) => { log.textContent = 'MQTT خطا: ' + e; });
  client.on('close', () => { log.textContent = 'MQTT قطع شد'; });
}

function publishValue(v){
  if(!client || !client.connected){
    connectMQTT(()=> {
      client.publish(topic, String(v));
      log.textContent = 'ارسال: ' + v;
    });
  } else {
    client.publish(topic, String(v));
    log.textContent = 'ارسال: ' + v;
  }
}

btnPub.onclick = () => {
  const v = parseFloat(slider.value).toFixed(2);
  publishValue(v);
};

let intervalId = null;
btnAuto.onclick = () => {
  btnAuto.disabled = true;
  btnStop.disabled = false;
  const step = 0.1;
  intervalId = setInterval(() => {
    let cur = parseFloat(slider.value);
    cur += step;
    if(cur > parseFloat(slider.max)) cur = parseFloat(slider.min);
    slider.value = cur.toFixed(2);
    val.textContent = cur.toFixed(2);
    publishValue(cur.toFixed(2));
  }, 600); // هر 600ms یک پیام
};

btnStop.onclick = () => {
  clearInterval(intervalId);
  btnAuto.disabled = false;
  btnStop.disabled = true;
  log.textContent = 'اتومات متوقف شد';
};
</script>
</body>
</html>
